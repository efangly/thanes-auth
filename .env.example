DATABASE_URL=postgresql://username:password@localhost:5432/smtrack_auth?schema=public
# Both secrets: at least 32 characters, and different from each other (the service refuses to start otherwise).
JWT_SECRET=your-secret-key-change-this-to-something-secure
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-to-something-secure
EXPIRE_TIME=15m
REFRESH_EXPIRE_TIME=7d
PORT=8080

# Comma-separated CIDRs/IPs of the proxies in front of this service (KrakenD).
# Requests from these peers are rate-limited by the client in X-Forwarded-For.
TRUSTED_PROXIES=

# Redis (cache, login lockout, token revocation).
# redis://[user:password@]host:port[/db]; use rediss:// for TLS.
REDIS_URL=redis://:password@localhost:6379/0

# bcrypt work factor for new password hashes (minimum 12).
BCRYPT_COST=12

# How long a soft-deleted record is kept before cmd/purge removes it.
SOFT_DELETE_RETENTION=365d

# Picture storage: RustFS / MinIO (any S3-compatible server).
# scripts/create-rustfs-bucket.sh creates the bucket and a user limited to it.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=auth-bucket-app
S3_SECRET_KEY=change-me
S3_BUCKET=auth-bucket
# Pictures are encrypted (AES-256-GCM) before they reach the bucket. 32 random bytes, base64:
#   openssl rand -base64 32
# Losing this key makes every stored picture unreadable; keep it in the secret store.
IMAGE_ENCRYPTION_KEY=
# Public prefix of GET /auth/image, stored in front of each picture's name (as seen by clients, i.e. via KrakenD).
IMAGE_BASE_URL=http://localhost:8080/auth/image
